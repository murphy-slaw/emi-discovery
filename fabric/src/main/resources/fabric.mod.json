{
    "schemaVersion": 1,
    "id": "emi_discovery",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/murphy_slaw/examplemod"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.funkpla.emi_discovery.EmiDiscoveryFabric"
        ],
        "modmenu": [
            "net.funkpla.emi_discovery.ModMenuConfig"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "emi": ">=1.1.22",
        "emixx": ">=1.2.11",
        "cloth-config": "*"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  